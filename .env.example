# Local Neo4j credentials. Change the example password before first startup.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-this-with-a-strong-local-password

# FastAPI connects to the HTTP Query API (not Bolt).
NEO4J_HTTP_URI=http://127.0.0.1:7474
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_SECONDS=15

# Host ports and local Neo4j memory limits.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_PAGECACHE_SIZE=512m

# Required for LLM extraction and LLM/hybrid recovery strategies.
GROQ_API_KEY=replace-with-your-groq-api-key
